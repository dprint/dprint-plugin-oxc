{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugins.dprint.dev/dprint/dprint-plugin-oxc/0.0.0/schema.json",
  "type": "object",
  "x-playground": {
    "input": [
      "import {readFile} from 'node:fs/promises'",
      "import type {Config} from \"./config.ts\"",
      "",
      "interface Task{id:number;title:string;done?:boolean}",
      "",
      "export async function loadTasks(path:string,config:Config):Promise<Task[]>{",
      "  const text=await readFile(path,'utf8')",
      "    const tasks:Task[]=JSON.parse(text)",
      "  return tasks.filter(task=>config.showDone||!task.done).sort((a,b)=>a.id-b.id)",
      "}",
      "",
      "export class TaskList{",
      "  private tasks=new Map<number,Task>()",
      "  add(task:Task){this.tasks.set(task.id,task);return this}",
      "  get size(){return this.tasks.size}",
      "}",
      "",
      "const drafts=['write docs',\"fix bug\"].map(title=>({title,done:false}))",
      "console.log(`created ${drafts.length} drafts`)"
    ]
  },
  "x-sections": [{
    "title": "General",
    "description": "The width, indentation, and line endings of all the files.",
    "properties": [
      "lineWidth",
      "indentWidth",
      "indentStyle",
      "lineEnding",
      "insertFinalNewline"
    ]
  }, {
    "title": "Semicolons, commas, and quotes",
    "description": "The punctuation that's added or removed.",
    "properties": [
      "semicolons",
      "trailingCommas",
      "quoteStyle",
      "jsxQuoteStyle",
      "quoteProperties",
      "arrowParentheses"
    ]
  }, {
    "title": "Line breaks and spaces",
    "description": "How code that doesn't fit within the line width is split up, and the spaces within braces.",
    "properties": [
      "expand",
      "operatorPosition",
      "experimentalTernaries",
      "bracketSpacing",
      "proseWrap"
    ]
  }, {
    "title": "HTML, Vue, and JSX",
    "description": "The formatting of HTML, Vue, and JSX elements and their attributes.",
    "properties": [
      "bracketSameLine",
      "attributePosition",
      "htmlWhitespaceSensitivity",
      "htmlWhitespaceSensitivityIgnore",
      "vueIndentScriptAndStyle"
    ]
  }, {
    "title": "Sorting",
    "description": "The sorting of imports, `package.json` properties, and Tailwind CSS classes.",
    "properties": [
      "sortImports",
      "experimentalSortImports",
      "sortPackageJson",
      "experimentalSortPackageJson",
      "sortTailwindcss",
      "experimentalTailwindcss"
    ]
  }, {
    "title": "Embedded code and comments",
    "description": "The formatting of code embedded in other code and of JSDoc comments.",
    "properties": [
      "embeddedLanguageFormatting",
      "jsdoc"
    ]
  }, {
    "title": "Languages",
    "description": "The languages that are formatted.",
    "properties": [
      "javascript.enabled",
      "typescript.enabled",
      "json.enabled",
      "jsonc.enabled",
      "json5.enabled",
      "graphql.enabled",
      "css.enabled",
      "scss.enabled",
      "less.enabled",
      "yaml.enabled",
      "markdown.enabled",
      "html.enabled",
      "vue.enabled",
      "toml.enabled"
    ]
  }],
  "properties": {
    "lineEnding": {
      "description": "The kind of line ending.",
      "type": "string",
      "default": "lf",
      "oneOf": [{
        "const": "lf",
        "description": "Line feed."
      }, {
        "const": "crlf",
        "description": "Carriage return, line feed."
      }, {
        "const": "cr",
        "description": "Carriage return."
      }]
    },
    "indentWidth": {
      "description": "The number of characters for an indent. Oxc supports 0 to 24, and other values use the default.",
      "default": 2,
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "indentStyle": {
      "description": "Whether to use tabs or spaces.",
      "type": "string",
      "default": "space",
      "oneOf": [{
        "const": "tab",
        "description": "Use tabs."
      }, {
        "const": "space",
        "description": "Use spaces."
      }],
      "x-example": {
        "input": [
          "function run() {",
          "  if (isReady) {",
          "    start();",
          "  }",
          "}"
        ]
      }
    },
    "lineWidth": {
      "description": "How many characters can be written on a single line. Oxc supports 1 to 320, and other values use the default.",
      "default": 100,
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "semicolons": {
      "description": "Whether to use semicolons.",
      "type": "string",
      "default": "always",
      "oneOf": [{
        "const": "always",
        "description": "Semicolons are always added at the end of each statement."
      }, {
        "const": "asNeeded",
        "description": "Semicolons are added only in places where it's needed, to protect from ASI."
      }],
      "x-example": {
        "input": [
          "const value = 5",
          "let items = [first, second];",
          ";[1, 2].forEach(log)"
        ]
      }
    },
    "quoteStyle": {
      "description": "The type of quote used when representing string literals. Applies to JS/TS, CSS/SCSS/Less, JSON5, YAML, and Markdown.",
      "type": "string",
      "default": "double",
      "oneOf": [{
        "const": "double",
        "description": "Use double quotes."
      }, {
        "const": "single",
        "description": "Use single quotes."
      }],
      "x-example": {
        "input": [
          "const single = 'text';",
          "const double = \"text\";",
          "const containsDouble = 'say \"hi\"';"
        ]
      }
    },
    "jsxQuoteStyle": {
      "description": "The type of quote used in JSX attributes.",
      "type": "string",
      "default": "double",
      "oneOf": [{
        "const": "double",
        "description": "Use double quotes."
      }, {
        "const": "single",
        "description": "Use single quotes."
      }],
      "x-example": {
        "extension": "tsx",
        "input": [
          "const label = 'text';",
          "const element = <div title='text' alt=\"say 'hi'\" />;"
        ]
      }
    },
    "quoteProperties": {
      "description": "Whether property names inside objects should be quoted. Applies to JS/TS and JSON5.",
      "type": "string",
      "default": "asNeeded",
      "oneOf": [{
        "const": "asNeeded",
        "description": "Quotes when necessary."
      }, {
        "const": "preserve",
        "description": "Maintains quotes on properties."
      }, {
        "const": "consistent",
        "description": "All properties are quoted if any property requires quoting."
      }],
      "x-example": {
        "input": [
          "const first = { \"a\": 1, b: 2 };",
          "const second = { \"c-d\": 1, e: 2 };"
        ]
      }
    },
    "arrowParentheses": {
      "description": "Whether to add non-necessary parentheses to arrow functions.",
      "type": "string",
      "default": "always",
      "oneOf": [{
        "const": "always",
        "description": "Parentheses are always added."
      }, {
        "const": "asNeeded",
        "description": "Parentheses are added only when necessary."
      }],
      "x-example": {
        "input": [
          "const double = x => x * 2;",
          "const triple = (x) => x * 3;"
        ]
      }
    },
    "trailingCommas": {
      "description": "Print trailing commas wherever possible in multi-line comma-separated syntactic structures. Outside of JS/TS, `all` and `es5` are the same and this applies to JSONC, JSON5, SCSS maps, YAML flow collections, and TOML arrays.",
      "type": "string",
      "default": "all",
      "oneOf": [{
        "const": "all",
        "description": "Trailing commas are always added."
      }, {
        "const": "es5",
        "description": "Trailing commas are added only in places where it's supported in ES5."
      }, {
        "const": "none",
        "description": "Trailing commas are never added."
      }],
      "x-example": {
        "config": { "lineWidth": 40 },
        "input": [
          "function createUser(firstName: string, lastName: string) {}",
          "const values = [firstValue, secondValue, thirdValue];"
        ]
      }
    },
    "bracketSpacing": {
      "description": "Surround the inner contents of some braces with spaces. Applies to JS/TS, JSON, GraphQL, and YAML.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "import {first, second} from \"./module.ts\";",
          "const {x, y} = point;"
        ]
      }
    },
    "bracketSameLine": {
      "description": "Place the last angle bracket in HTML, Vue, and JSX tags on the same line as the last attribute.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": { "lineWidth": 40 },
        "extension": "tsx",
        "input": [
          "const element = <Button kind=\"primary\" size=\"large\" onClick={save}>Save</Button>;"
        ]
      }
    },
    "attributePosition": {
      "description": "How HTML, Vue, and JSX/TSX attributes are positioned.",
      "type": "string",
      "default": "auto",
      "oneOf": [{
        "const": "auto",
        "description": "Attributes are automatically positioned."
      }, {
        "const": "multiline",
        "description": "Each attribute is placed on its own line."
      }],
      "x-example": {
        "extension": "tsx",
        "input": [
          "const element = <input type=\"text\" value={name} />;"
        ]
      }
    },
    "expand": {
      "description": "Whether to expand object and array literals to multiple lines. Applies to JS/TS and JSON.",
      "type": "string",
      "default": "auto",
      "oneOf": [{
        "const": "auto",
        "description": "Objects are expanded when the first property has a leading newline. Arrays are always collapsed unless they contain a newline."
      }, {
        "const": "never",
        "description": "Objects and arrays are never expanded, if they are shorter than the line width."
      }],
      "x-example": {
        "input": [
          "const point = {",
          "  x: 1, y: 2 };",
          "const size = { width: 10,",
          "  height: 20 };"
        ]
      }
    },
    "operatorPosition": {
      "description": "Controls the position of operators in binary expressions when they wrap lines.",
      "type": "string",
      "default": "end",
      "oneOf": [{
        "const": "start",
        "description": "Places the operator at the beginning of the next line."
      }, {
        "const": "end",
        "description": "Places the operator at the end of the current line."
      }],
      "x-example": {
        "config": { "lineWidth": 40 },
        "input": [
          "const isValid = firstCondition && secondCondition && thirdCondition;"
        ]
      }
    },
    "experimentalTernaries": {
      "description": "[EXPERIMENTAL - NOT FULLY SUPPORTED] Try Prettier's new ternary formatting before it becomes the default behavior.",
      "type": "boolean",
      "default": false
    },
    "htmlWhitespaceSensitivityIgnore": {
      "description": "Whether HTML, Vue, and HTML-in-JS templates always use hard line breaks for wrapping. Used when `htmlWhitespaceSensitivity` is unset.",
      "type": "boolean",
      "default": false,
      "x-example": {
        "config": { "lineWidth": 40 },
        "extension": "html",
        "input": [
          "<span class=\"first second\">Some text in a span element.</span>",
          "<div class=\"first second\">Some text in a div element.</div>"
        ]
      }
    },
    "proseWrap": {
      "description": "How to wrap prose in YAML and Markdown.",
      "type": "string",
      "default": "preserve",
      "oneOf": [{
        "const": "preserve",
        "description": "Keep the line breaks as they are."
      }, {
        "const": "always",
        "description": "Wrap prose when it exceeds the line width."
      }, {
        "const": "never",
        "description": "Unwrap each block of prose onto a single line."
      }],
      "x-example": {
        "config": { "lineWidth": 40 },
        "extension": "md",
        "input": [
          "This is a long paragraph of text that goes over the line width.",
          "",
          "This paragraph",
          "has a line break."
        ]
      }
    },
    "embeddedLanguageFormatting": {
      "description": "Whether to format code embedded in a file (ex. CSS or GraphQL in a JS template literal, code blocks in JSDoc comments, or front matter in CSS).",
      "type": "string",
      "default": "auto",
      "oneOf": [{
        "const": "auto",
        "description": "Format embedded code when its language is identified."
      }, {
        "const": "off",
        "description": "Never format embedded code."
      }],
      "x-example": {
        "input": [
          "const styles = css`",
          "  .button{color:red;margin:0 auto}",
          "`;"
        ]
      }
    },
    "insertFinalNewline": {
      "description": "Whether to end files with a newline.",
      "type": "boolean",
      "default": true
    },
    "javascript.enabled": {
      "description": "Whether to format JavaScript and JSX files.",
      "type": "boolean",
      "default": true
    },
    "typescript.enabled": {
      "description": "Whether to format TypeScript and TSX files.",
      "type": "boolean",
      "default": true
    },
    "json.enabled": {
      "description": "Whether to format JSON files.",
      "type": "boolean",
      "default": true
    },
    "jsonc.enabled": {
      "description": "Whether to format JSONC files.",
      "type": "boolean",
      "default": true
    },
    "json5.enabled": {
      "description": "Whether to format JSON5 files.",
      "type": "boolean",
      "default": true
    },
    "graphql.enabled": {
      "description": "Whether to format GraphQL files.",
      "type": "boolean",
      "default": true
    },
    "css.enabled": {
      "description": "Whether to format CSS files.",
      "type": "boolean",
      "default": true
    },
    "scss.enabled": {
      "description": "Whether to format SCSS files.",
      "type": "boolean",
      "default": true
    },
    "less.enabled": {
      "description": "Whether to format Less files.",
      "type": "boolean",
      "default": true
    },
    "yaml.enabled": {
      "description": "Whether to format YAML files.",
      "type": "boolean",
      "default": true
    },
    "markdown.enabled": {
      "description": "Whether to format Markdown files.",
      "type": "boolean",
      "default": true
    },
    "vue.enabled": {
      "description": "Whether to format Vue files.",
      "type": "boolean",
      "default": true
    },
    "vueIndentScriptAndStyle": {
      "description": "Whether to indent script and style blocks in Vue files.",
      "type": "boolean",
      "default": false
    },
    "html.enabled": {
      "description": "Whether to format HTML and XHTML files.",
      "type": "boolean",
      "default": true
    },
    "htmlWhitespaceSensitivity": {
      "description": "Whitespace sensitivity in HTML, Vue, and HTML-in-JS templates. Takes precedence over `htmlWhitespaceSensitivityIgnore`.",
      "type": "string",
      "default": "css",
      "oneOf": [{
        "const": "css",
        "description": "Whitespace around an element is significant when the element is inline by default in CSS (ex. `<span>`), so it's not added or removed there."
      }, {
        "const": "strict",
        "description": "Whitespace around every element is significant."
      }, {
        "const": "ignore",
        "description": "Whitespace around every element is insignificant, so it's added or removed freely."
      }],
      "x-example": {
        "config": { "lineWidth": 40 },
        "extension": "html",
        "input": [
          "<span class=\"first second\">Some text in a span element.</span>",
          "<div class=\"first second\">Some text in a div element.</div>"
        ]
      }
    },
    "toml.enabled": {
      "description": "Whether to format TOML files.",
      "type": "boolean",
      "default": true
    },
    "sortPackageJson": {
      "$ref": "#/definitions/sortPackageJson"
    },
    "experimentalSortPackageJson": {
      "description": "Alias of `sortPackageJson`.",
      "allOf": [{
        "$ref": "#/definitions/sortPackageJson"
      }]
    },
    "sortImports": {
      "$ref": "#/definitions/sortImports"
    },
    "experimentalSortImports": {
      "description": "Alias of `sortImports`.",
      "allOf": [{
        "$ref": "#/definitions/sortImports"
      }]
    },
    "sortTailwindcss": {
      "$ref": "#/definitions/sortTailwindcss"
    },
    "experimentalTailwindcss": {
      "description": "Alias of `sortTailwindcss`.",
      "allOf": [{
        "$ref": "#/definitions/sortTailwindcss"
      }]
    },
    "jsdoc": {
      "description": "Enable JSDoc comment formatting. May be a boolean or an object of options.",
      "oneOf": [{
        "type": "boolean",
        "description": "Enables it with the default options when `true`."
      }, {
        "type": "object",
        "properties": {
          "capitalizeDescriptions": {
            "description": "Capitalize the first letter of tag descriptions.",
            "type": "boolean",
            "default": true
          },
          "commentLineStrategy": {
            "description": "How to format JSDoc comment blocks.",
            "type": "string",
            "default": "singleLine",
            "oneOf": [{
              "const": "singleLine",
              "description": "Convert to a single line when possible."
            }, {
              "const": "multiline",
              "description": "Always use multiple lines."
            }, {
              "const": "keep",
              "description": "Preserve the original line layout."
            }]
          },
          "separateTagGroups": {
            "description": "Add blank lines between different tag groups.",
            "type": "boolean",
            "default": false
          },
          "separateReturnsFromParam": {
            "description": "Add a blank line between the last `@param` and `@returns`.",
            "type": "boolean",
            "default": false
          },
          "bracketSpacing": {
            "description": "Add spaces inside JSDoc type braces.",
            "type": "boolean",
            "default": false
          },
          "descriptionWithDot": {
            "description": "Add a trailing dot to descriptions.",
            "type": "boolean",
            "default": false
          },
          "addDefaultToDescription": {
            "description": "Append default values to `@param` descriptions.",
            "type": "boolean",
            "default": true
          },
          "preferCodeFences": {
            "description": "Use fenced code blocks for code without a language tag.",
            "type": "boolean",
            "default": false
          },
          "lineWrappingStyle": {
            "description": "How JSDoc description lines wrap at the configured line width.",
            "type": "string",
            "default": "greedy",
            "oneOf": [{
              "const": "greedy",
              "description": "Always re-wrap text to fit the line width."
            }, {
              "const": "balance",
              "description": "Keep original line breaks when they fit."
            }]
          },
          "descriptionTag": {
            "description": "Emit a `@description` tag instead of an inline description.",
            "type": "boolean",
            "default": false
          },
          "keepUnparsableExampleIndent": {
            "description": "Preserve indentation in unparsable `@example` code.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }]
    }
  },
  "definitions": {
    "sortImports": {
      "description": "Sort import statements. May be a boolean or an object of options.",
      "oneOf": [{
        "type": "boolean",
        "description": "Enables it with the default options when `true`."
      }, {
        "type": "object",
        "properties": {
          "partitionByNewline": {
            "description": "Partition imports by newlines.",
            "type": "boolean",
            "default": false
          },
          "partitionByComment": {
            "description": "Partition imports by comments.",
            "type": "boolean",
            "default": false
          },
          "sortSideEffects": {
            "description": "Sort side effects imports.",
            "type": "boolean",
            "default": false
          },
          "order": {
            "description": "Sort order (ascending or descending).",
            "type": "string",
            "default": "asc",
            "oneOf": [{
              "const": "asc",
              "description": "Sort in ascending order (A-Z)."
            }, {
              "const": "desc",
              "description": "Sort in descending order (Z-A)."
            }]
          },
          "ignoreCase": {
            "description": "Ignore case when sorting.",
            "type": "boolean",
            "default": true
          },
          "newlinesBetween": {
            "description": "Whether to insert blank lines between different import groups. Defaults to `false` when `partitionByNewline` is `true` because the two cannot be used together.",
            "type": "boolean",
            "default": true
          },
          "newlineBoundaryOverrides": {
            "description": "Whether to insert blank lines at each boundary between import groups. A `null` value uses `newlinesBetween`.",
            "type": "array",
            "items": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "default": []
          },
          "internalPattern": {
            "description": "Patterns to identify internal imports.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "~/",
              "@/",
              "#"
            ]
          },
          "groups": {
            "description": "The groups to sort the imports into. Each item is a group name, an array of group names that are sorted together, or a `{ \"newlinesBetween\": boolean }` marker that overrides whether there is a blank line between the groups before and after it.",
            "type": "array",
            "items": {
              "oneOf": [{
                "type": "string"
              }, {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }, {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "newlinesBetween"
                ],
                "properties": {
                  "newlinesBetween": {
                    "type": "boolean"
                  }
                }
              }]
            },
            "default": [
              "builtin",
              "external",
              [
                "internal",
                "subpath"
              ],
              [
                "parent",
                "sibling",
                "index"
              ],
              "style",
              "unknown"
            ]
          },
          "customGroups": {
            "description": "Definitions for custom import groups referenced by `groups`.",
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "groupName": {
                  "description": "The custom group name.",
                  "type": "string"
                },
                "elementNamePattern": {
                  "description": "Glob patterns that match import sources.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "selector": {
                  "description": "The import selector that must match.",
                  "type": "string",
                  "oneOf": [{
                    "const": "type",
                    "description": "Type-only imports (ex. `import type { A } from \"a\"`)."
                  }, {
                    "const": "side_effect_style",
                    "description": "Style file imports without bindings (ex. `import \"./styles.css\"`)."
                  }, {
                    "const": "side_effect",
                    "description": "Imports without bindings (ex. `import \"./setup.ts\"`)."
                  }, {
                    "const": "style",
                    "description": "Style file imports (ex. CSS or SCSS files)."
                  }, {
                    "const": "index",
                    "description": "Index file imports (ex. `./` or `../`)."
                  }, {
                    "const": "sibling",
                    "description": "Sibling module imports (ex. `./a`)."
                  }, {
                    "const": "parent",
                    "description": "Parent module imports (ex. `../a`)."
                  }, {
                    "const": "subpath",
                    "description": "Subpath imports from the `imports` field of `package.json` (ex. `#a`)."
                  }, {
                    "const": "internal",
                    "description": "Imports that match `internalPattern` (ex. `~/a` or `@/a`)."
                  }, {
                    "const": "builtin",
                    "description": "Built-in module imports (ex. `node:fs` or `fs`)."
                  }, {
                    "const": "external",
                    "description": "External module imports (ex. packages in `node_modules`)."
                  }, {
                    "const": "import",
                    "description": "Any import."
                  }]
                },
                "modifiers": {
                  "description": "Import modifiers that must all be present.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "oneOf": [{
                      "const": "side_effect",
                      "description": "Imports without bindings."
                    }, {
                      "const": "type",
                      "description": "Type-only imports."
                    }, {
                      "const": "value",
                      "description": "Imports that aren't type-only."
                    }, {
                      "const": "default",
                      "description": "Imports with a default specifier."
                    }, {
                      "const": "wildcard",
                      "description": "Imports with a namespace specifier (ex. `* as a`)."
                    }, {
                      "const": "named",
                      "description": "Imports with named specifiers."
                    }]
                  },
                  "default": []
                }
              }
            }
